# Copy to .env for local development. Never commit the real file.
# In production these come from Cloud Run: secrets via Secret Manager,
# everything else as plain environment variables (see deploy.sh).

# --- Required -------------------------------------------------------------

# Shared secret. Callers send it as "Authorization: Bearer <value>".
# The service refuses to start without it.
SERVICE_API_KEY=

# Gemini credentials. Required unless LLM_PROVIDER=mock.
GEMINI_API_KEY=

# --- Models ---------------------------------------------------------------

# Model for note extraction.
EXTRACTION_MODEL=gemini-3.6-flash

# Model for /chat. Falls back to EXTRACTION_MODEL when unset.
CHAT_MODEL=gemini-3.6-flash

# Whisper size: tiny, base, small, medium. The Docker image contains only
# the model it was built with (base) and cannot download another, so
# change this in a container only together with the WHISPER_MODEL build arg.
WHISPER_MODEL=base

# --- Audio fetching -------------------------------------------------------

# Comma-separated hosts recordings may be downloaded from. A leading "*."
# matches any subdomain.
ALLOWED_AUDIO_HOSTS=*.public.blob.vercel-storage.com,*.blob.vercel-storage.com

# Whisper runs allowed at once per instance. Each holds a whole decoded
# recording in memory; further requests wait their turn.
MAX_CONCURRENT_TRANSCRIPTIONS=2

# --- Optional -------------------------------------------------------------

# "gemini" (default) or "mock", which returns canned output with no API call.
# LLM_PROVIDER=gemini

# Deadline in seconds for a single model request.
# LLM_TIMEOUT_SECONDS=60

# LOG_LEVEL=INFO

# Local testing only: permits plain HTTP and private/loopback audio hosts.
# Never set this in production.
# ALLOW_LOCAL_AUDIO=true
